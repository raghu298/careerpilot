# ---- Core (optional) --------------------------------------------------------
# With no key set, FinPilot runs fully offline using deterministic stand-ins.
# Set this to use the real OpenAI adapters (routing, RAG generation, tool-calling).
OPENAI_API_KEY=

# ---- Analytics Agent database (optional) ------------------------------------
# When unset, an in-memory read-only fake dataset is used.
DATABASE_URL=
DATABASE_READONLY_URL=

# ---- Market Agent over MCP (optional) ---------------------------------------
# When unset, a deterministic fake market-data MCP source is used.
MARKET_MCP_URL=
MARKET_MCP_TOKEN=

# ---- Notify Agent delivery (optional; demo captures to the Outbox otherwise) -
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_TEST_RECIPIENT=

# ---- Web ---------------------------------------------------------------------
# Origin the API accepts CORS from (the Next.js dev server by default).
FRONTEND_ORIGIN=http://localhost:3000
